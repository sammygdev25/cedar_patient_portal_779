# Local development values.
# Production: DEBUG=0, a long random SECRET_KEY, ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS set to your domains,
# SEED_DEMO unset. With DEBUG=0 the app is HTTPS only; set SECURE_SSL_REDIRECT=0 only behind a proxy that does not send X-Forwarded-Proto.
SECRET_KEY=${SECRET_KEY:-changeme-in-production}
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1
SEED_DEMO=1
# This app's own sign-in passwords, one per role (made when it was generated, kept in backend/.env); start.sh
# reads them from there or from the environment. With none set, no sign-in works.
SEED_PATIENT_PASSWORD=choose-a-password
SEED_DOCTOR_PASSWORD=choose-a-password
SEED_RECEPTIONIST_PASSWORD=choose-a-password
# A deploy's owner: the admin account the production start makes once. Sign in with the email; roles at /admin/.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database (PostgreSQL). Unset, previews start a local server; production must set it.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Google sign-in: a Google Cloud OAuth client (Web application) with PUBLIC_URL + /api/auth/google/callback/ as an
# authorized redirect URI. Unset, the button says Google sign-in is not set up and the rest of the app runs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api
